{
  "name": "@senseihq/emaki-cli",
  "version": "0.8.0",
  "description": "The motion stories command line: set a project up, install the Claude plugin (skills, agents, playbook), run the production steps (validate, sheet, voice, fit, render, build) per film and locale, then stage, publish and run a campaign.",
  "type": "module",
  "license": "MIT",
  "author": "sensei-hq",
  "repository": { "type": "git", "url": "git+https://github.com/sensei-hq/emaki.git", "directory": "packages/emaki-cli" },
  "keywords": ["emaki", "cli", "motion", "video", "tts", "claude", "plugin", "skills"],
  "bin": { "emaki": "src/index.js" },
  "engines": { "node": ">=20.10" },
  "files": ["src/**/*.js", "templates/**", "plugin/**", "README.md", "LICENSE"],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/api.js"
  },
  "scripts": {
    "build": "node --check src/index.js",
    "prepublishOnly": "cp ../../LICENSE . && bun run build",
    "postpublish": "rm -f LICENSE"
  },
  "dependencies": { "@senseihq/emaki": "workspace:*", "@senseihq/emaki-posting": "workspace:*", "sade": "^1.8.1" },
  "peerDependencies": { "playwright": ">=1.40" },
  "peerDependenciesMeta": { "playwright": { "optional": true } },
  "publishConfig": { "access": "public" }
}
