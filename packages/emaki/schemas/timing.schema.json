{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emaki/timing.schema.json",
  "title": "content/films/<slug>/timing.<locale>.json (written by motion.py fit; holds by hand)",
  "type": "object",
  "properties": {
    "scenes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dur": {
            "type": "number"
          },
          "holds": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}