{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emaki/timing.schema.json",
  "title": "content/films/<slug>/timing.<locale>.json (dur by emaki fit, voice by emaki voice-web, holds by hand)",
  "type": "object",
  "properties": {
    "scenes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dur": {
            "type": "number"
          },
          "holds": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "voice": {
            "type": "number",
            "minimum": 0,
            "description": "Where the scene's narration (voice/<locale>/<scene>.m4a) starts, in seconds into the scene"
          }
        }
      }
    }
  }
}
