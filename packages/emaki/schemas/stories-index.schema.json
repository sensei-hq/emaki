{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emaki/stories-index.schema.json",
  "title": "content/stories/index.json (locale-neutral)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "slug",
      "publish_date"
    ],
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "publish_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "kind": {
        "enum": [
          "film",
          "short",
          "article"
        ]
      },
      "topic": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "film": {
        "type": "string"
      },
      "cover": {
        "type": "string"
      },
      "minutes": {
        "type": "number"
      },
      "social": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "related": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        }
      }
    }
  }
}