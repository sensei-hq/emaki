{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emaki/site.schema.json",
  "title": "content/site.json",
  "type": "object",
  "required": [
    "name",
    "url",
    "timeZone",
    "locales",
    "defaultLocale"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "timeZone": {
      "type": "string",
      "description": "IANA zone; stories publish by date here"
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      },
      "minItems": 1
    },
    "defaultLocale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "rtl": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}