{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emaki/film.schema.json",
  "title": "content/films/<slug>/film.json",
  "type": "object",
  "required": [
    "title",
    "background",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "look": {
      "type": "string"
    },
    "background": {
      "type": "string"
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dark": {
      "description": "The film's dark look: present when look.css styles #stage[data-mode=\"dark\"]. Without it the film is always drawn light.",
      "type": "object",
      "required": [
        "background"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "family"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "weights": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "dur"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "dur": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "desc": {
            "type": "string"
          },
          "settle": {
            "type": "number",
            "minimum": 0,
            "description": "When the scene's motion is over (seconds). emaki fit never ends a narrated scene before it. JSON scenes need none (their tracks say); JS scenes without it keep their design length."
          }
        }
      }
    },
    "cover": {
      "type": "object",
      "required": [
        "scene"
      ],
      "properties": {
        "scene": {
          "type": "string"
        },
        "at": {
          "type": "number"
        }
      }
    }
  }
}