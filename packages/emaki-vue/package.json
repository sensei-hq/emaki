{
  "name": "@senseihq/emaki-vue",
  "version": "0.1.2",
  "description": "Vue 3 components and composables for motion stories: article figures, the story player, a controlled scene player and the video capture page.",
  "type": "module",
  "license": "MIT",
  "author": "SenecaGlobal",
  "repository": { "type": "git", "url": "git+https://github.com/sensei-hq/emaki.git", "directory": "packages/emaki-vue" },
  "keywords": ["emaki", "vue", "nuxt", "motion", "animation", "explainer", "i18n"],
  "sideEffects": false,
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "src", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsc --project tsconfig.build.json",
    "prepublishOnly": "cp ../../LICENSE . && bun run build",
    "postpublish": "rm -f LICENSE"
  },
  "peerDependencies": { "vue": "^3.4.0" },
  "dependencies": { "@senseihq/emaki": "workspace:*" },
  "devDependencies": { "vue": "^3.5.13" },
  "publishConfig": { "access": "public" }
}
