{
  "name": "@senseihq/emaki-svelte",
  "version": "0.1.2",
  "description": "Svelte 5 components for motion stories: article figures, the story player, a controlled scene player and the video capture page.",
  "type": "module",
  "license": "MIT",
  "author": "SenecaGlobal",
  "repository": { "type": "git", "url": "git+https://github.com/sensei-hq/emaki.git", "directory": "packages/emaki-svelte" },
  "keywords": ["emaki", "svelte", "sveltekit", "motion", "animation", "explainer", "i18n"],
  "sideEffects": ["**/*.css"],
  "files": ["dist", "!dist/**/*.spec.*", "README.md", "LICENSE"],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": { "types": "./dist/index.d.ts", "svelte": "./dist/index.js", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepublishOnly": "cp ../../LICENSE . && bun run build",
    "postpublish": "rm -f LICENSE"
  },
  "peerDependencies": { "svelte": "^5.0.0" },
  "dependencies": { "@senseihq/emaki": "workspace:*" },
  "devDependencies": { "@sveltejs/package": "^2.3.10", "svelte": "^5.28.0", "svelte-check": "^4.2.1" },
  "publishConfig": { "access": "public" }
}
